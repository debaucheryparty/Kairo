{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kairo",
  "version": "0.1.0",
  "identifier": "com.kairo.desktop",
  "build": {
    "frontendDist": "../../kairo-web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter kairo-web dev",
    "beforeBuildCommand": "pnpm --filter kairo-web build"
  },
  "app": {
    "windows": [
      {
        "title": "Kairo",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/kairo-backend"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/debaucheryparty/Kairo/releases/latest/download/updater.json"
      ],
      "pubkey": "UPDATE_PUBKEY_PLACEHOLDER"
    }
  }
}
